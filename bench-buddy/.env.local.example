# Copy this file to ".env.local" and fill in the values.
# NEVER share or commit .env.local - it holds your secret keys.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret! Server only. Lets our server save tickets from the public intake form.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Anthropic (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend (resend.com -> API keys). Leave blank to skip sending emails. ---
RESEND_API_KEY=
# The "from" address. Must be on a domain you verified in Resend.
# For first tests you can use: onboarding@resend.dev (only delivers to YOUR Resend email).
EMAIL_FROM=onboarding@resend.dev

# --- The public web address of this app (no slash at the end) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
